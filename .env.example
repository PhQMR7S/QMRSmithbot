APP_ENV=development
APP_NAME=QMRSmithbot
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://qmrsmith:qmrsmith@localhost:5432/qmrsmith
REDIS_URL=redis://localhost:6379/0
TELEGRAM_FACTORY_BOT_TOKEN=replace_me
TELEGRAM_FACTORY_ADMIN_IDS=[]
TELEGRAM_FACTORY_ENABLED=false
TELEGRAM_FACTORY_USERNAME=your_factory_bot
AUTH_TELEGRAM_ENABLED=false
# Set true ONLY after a dedicated generated-bot consumer passes a live end-to-end test.
TELEGRAM_RUNTIME_CONSUMER_VERIFIED=false
TELEGRAM_FACTORY_WEBHOOK_SECRET=replace_with_a_random_url_safe_secret
TELEGRAM_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_fernet_key
TELEGRAM_WEBHOOK_BASE_URL=https://app.example.com
TELEGRAM_WORKER_POLL_SECONDS=1.0
TELEGRAM_WORKER_BATCH_SIZE=10
TELEGRAM_WORKER_LEASE_SECONDS=120
TELEGRAM_WORKER_HANDLER_TIMEOUT_SECONDS=90
TELEGRAM_WORKER_MAX_ATTEMPTS=8
TELEGRAM_WORKER_SHUTDOWN_GRACE_SECONDS=30
PLATFORM_REQUIRED_CHANNEL=@your_required_channel
PLATFORM_REQUIRED_CHANNEL_ENABLED=false
AUTH_DEV_BOOTSTRAP_ENABLED=true
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=https://id.example.com
AUTH_OIDC_CLIENT_ID=qmrsmithbot
AUTH_OIDC_CLIENT_SECRET=replace_me
AUTH_OIDC_REDIRECT_URI=https://app.example.com/api/v1/auth/oidc/callback
AUTH_STATE_ENCRYPTION_KEY=replace_with_a_fernet_key
SESSION_ABSOLUTE_TTL_MINUTES=480
SESSION_IDLE_TTL_MINUTES=30
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Bounded factory text templates; advanced worker activation remains independent.
TELEGRAM_INLINE_RUNTIME_ENABLED=false
TELEGRAM_INGRESS_BASE_URL=
